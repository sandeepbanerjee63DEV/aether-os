# Database (Vercel Postgres auto-injects POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING;
# alias them to DATABASE_URL / DIRECT_DATABASE_URL in Vercel project settings, OR set
# these directly for local dev / other Postgres providers)
DATABASE_URL="postgresql://aether:aether_secret@localhost:5432/aether_os?schema=public"
DIRECT_DATABASE_URL="postgresql://aether:aether_secret@localhost:5432/aether_os?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_REFRESH_SECRET="change-me-refresh-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# AI (future LLM integration)
OPENAI_API_KEY=""
AI_PROVIDER="mock"

# Email (Resend — used by the Next Best Action / lead action flow)
# Get a key at https://resend.com/api-keys. Without these, the action route
# still works and the email payload is logged to the server console.
RESEND_API_KEY=""
EMAIL_FROM="AETHER OS <onboarding@resend.dev>"
EMAIL_REPLY_TO=""

# WebSocket
WS_PORT="3001"
